{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "rootDir": ".",
    "outDir": "build",
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "test",
    "types",
    "package.json",
    "docs/swagger.ts"
  ],
}